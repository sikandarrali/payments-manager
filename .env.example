# Appwrite
NEXT_PUBLIC_ENDPOINT=https://<your-appwrite-endpoint>/v1
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_DATABASE_ID=payments-manager
NEXT_PUBLIC_COLLECTION_ID_ITEMS=items
APPWRITE_API_KEY=

# Auth redirects
NEXT_PUBLIC_CALLBACK_AFTER_LOGIN=http://localhost:3000
NEXT_PUBLIC_CALLBACK_AFTER_LOGIN_FAILED=http://localhost:3000/404

# App storage keys
NEXT_PUBLIC_USER_SESSION_COOKIE_NAME=sipps_pm_session
NEXT_PUBLIC_LOCAL_STORAGE_THEME_NAME=sipps_pm_theme

# Localazy (optional, only needed for `npm run localazy:upload`/`localazy:download`)
LOCALAZY_WRITE_KEY=
LOCALAZY_READ_KEY=
